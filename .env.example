# ---- Required ----------------------------------------------------------------
# Wallet that RECEIVES payments (USDC on Base). Address only, never a private key.
PAY_TO_ADDRESS=0xYourWalletAddress

# eip155:84532 = Base Sepolia testnet (free test USDC; start here)
# eip155:8453  = Base mainnet (real money; needs the CDP keys, ADMIN_TOKEN and an https PUBLIC_URL)
NETWORK=eip155:84532

# Public address of this server (used in the catalog and llms.txt)
PUBLIC_URL=http://localhost:4021
PORT=4021

# Long random string for the operator console (abuse reports, room shutdown).
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# ---- Mainnet ----------------------------------------------------------------
# Real money needs a mainnet payment processor ("facilitator"). Either:
#   a) Coinbase CDP API keys (portal.cdp.coinbase.com) - also lists you in Coinbase's Bazaar, or
#   b) a no-account facilitator, e.g. PayAI (first 1,000 settlements free, then ~$0.002 each):
# FACILITATOR_URL=https://facilitator.payai.network
# Coinbase Developer Platform API keys (take priority over FACILITATOR_URL when set)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- Optional ---------------------------------------------------------------
# Where room data is saved. Use a persistent volume in production (Docker sets /data).
# DATA_DIR=./data
# DEV_SKIP_PAYMENTS=1      # local testing only: turns payments off (refused on mainnet)

# Only for the test scripts (room-demo, deal-demo). Use a THROWAWAY wallet with a few test USDC.
BUYER_PRIVATE_KEY=

# BRAND_NAME=Suppressor
# CONTACT_EMAIL=you@yourdomain
# DEAL_CHECKOUT=1   # x402 checkout between third-party agents: OFF until legal advice
